rules_version = '2';

// Reglas de seguridad de GymApp.
// Cópialas en Firebase › Firestore Database › Reglas y pulsa «Publicar»
// (o despliega con `firebase deploy --only firestore:rules`).
//
// - Cada cliente lee y escribe solo lo suyo.
// - El entrenador lee los perfiles, rutinas, entrenos y notas de sus clientes.
// - Las rutinas creadas por el cliente solo las edita el cliente: el entrenador
//   propone cambios con documentos de «suggestions».
// - Los datos de cuerpo (Visbody) solo los ve el entrenador si el cliente los
//   comparte: la app escribe trainerId en el informe solo en ese caso.
// - users/{uid}/private (ajustes y notas de máquinas) es solo del propio usuario.

service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function userPath(id) { return /databases/$(db)/documents/users/$(id); }
    function profile(id) { return get(userPath(id)).data; }
    function myTrainer() { return exists(userPath(me())) ? profile(me()).get('trainerId', null) : null; }
    function isTrainerOf(clientId) {
      return exists(userPath(clientId)) && profile(clientId).get('trainerId', null) == me();
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow get: if signedIn() && (
        uid == me()
        || resource.data.get('trainerId', null) == me()
        || uid == myTrainer()
      );
      // el entrenador lista a sus clientes: where('trainerId', '==', uid)
      allow list: if signedIn() && resource.data.trainerId == me();
      allow create: if signedIn() && uid == me()
        && request.resource.data.role in ['client', 'trainer'];
      allow update: if signedIn() && uid == me()
        && request.resource.data.role == resource.data.role;
      allow delete: if signedIn() && uid == me();

      match /private/{docId} {
        allow read, write: if signedIn() && uid == me();
      }
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.trainerId == me();
      allow create: if signedIn() && request.resource.data.trainerId == me();
      allow update: if signedIn() && (
        resource.data.trainerId == me()
        || (resource.data.get('usedBy', null) == null
            && request.resource.data.usedBy == me()
            && changedOnly(['usedBy']))
      );
      allow delete: if signedIn() && resource.data.trainerId == me();
    }

    match /routines/{id} {
      allow read: if signedIn() && (
        resource.data.ownerId == me()
        || resource.data.get('clientId', null) == me()
        || resource.data.get('trainerId', null) == me()
      );
      allow create: if signedIn() && request.resource.data.ownerId == me()
        && (request.resource.data.get('clientId', null) == null
            || request.resource.data.clientId == me()
            || isTrainerOf(request.resource.data.clientId));
      allow update: if signedIn() && resource.data.ownerId == me()
        && request.resource.data.ownerId == me();
      allow delete: if signedIn() && resource.data.ownerId == me();
    }

    match /workouts/{id} {
      allow read: if signedIn() && (
        resource.data.clientId == me()
        || resource.data.get('trainerId', null) == me()
      );
      allow create: if signedIn() && request.resource.data.clientId == me();
      allow update: if signedIn() && resource.data.clientId == me()
        && request.resource.data.clientId == me();
      allow delete: if signedIn() && resource.data.clientId == me();
    }

    match /suggestions/{id} {
      allow read: if signedIn() && (
        resource.data.clientId == me() || resource.data.trainerId == me()
      );
      allow create: if signedIn() && request.resource.data.trainerId == me()
        && isTrainerOf(request.resource.data.clientId);
      allow update: if signedIn() && (
        resource.data.trainerId == me()
        || (resource.data.clientId == me() && changedOnly(['status', 'answeredAt']))
      );
      allow delete: if signedIn() && (
        resource.data.trainerId == me() || resource.data.clientId == me()
      );
    }

    match /bodyReports/{id} {
      allow read: if signedIn() && (
        resource.data.clientId == me()
        || resource.data.get('trainerId', null) == me()
      );
      allow create: if signedIn() && request.resource.data.clientId == me();
      allow update: if signedIn() && resource.data.clientId == me()
        && request.resource.data.clientId == me();
      allow delete: if signedIn() && resource.data.clientId == me();
    }

    match /notes/{id} {
      allow read: if signedIn() && (
        resource.data.clientId == me() || resource.data.trainerId == me()
      );
      allow create: if signedIn() && request.resource.data.clientId == me();
      allow update: if signedIn() && (
        (resource.data.trainerId == me() && changedOnly(['seen']))
        || resource.data.clientId == me()
      );
      allow delete: if signedIn() && resource.data.clientId == me();
    }
  }
}
